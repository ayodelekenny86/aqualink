# Supabase local development environment variables
# Copy to supabase/.env and fill in values
# Never commit the real .env file

# Supabase project (get from supabase.com dashboard)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-from-supabase-cli
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-cli

# Operations authentication
# Generate with: openssl rand -hex 32
OPS_SESSION_SECRET=your-ops-session-secret-here

# Bootstrap token for creating the first ops account (generate a secure random string)
OPS_BOOTSTRAP_TOKEN=your-bootstrap-token-here
OPS_ADMIN_EMAIL=admin@example.com
OPS_ADMIN_PASSWORD=your-secure-password-12-chars-min

# Paystack payments
# Get from Paystack dashboard (Settings > API Keys)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# App origin for Paystack callback URL (used in payment initialization)
APP_ORIGIN=http://127.0.0.1:3000

# CORS allowed origins (comma-separated).
# Required: without an entry matching the browser's origin, the edge functions
# return no Access-Control-Allow-Origin header and the browser blocks the Paystack
# redirect flow. There is no permissive default on purpose.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000