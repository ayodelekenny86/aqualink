  "files": [
    {
      "path": "src/modules/all/schema/schema.model.jsonc",
      "content": "// src/modules/all/schema/schema.model.jsonc\n// Database schema definition for the 'all' module.\n// This file describes the structure of the 'all' table, including fields, types, indexes, and relations.\n// It is used by the application to generate migrations and to provide type information.\n\n{\n  \"table\": \"all\",\n  \"description\": \"Main table for the 'all' module\",\n  \"fields\": {\n    \"id\": {\n      \"type\": \"uuid\",\n      \"primaryKey\": true,\n      \"default\": \"gen_random_uuid()\",\n      \"description\": \"Unique identifier for the record\"\n    },\n    \"name\": {\n      \"type\": \"text\",\n      \"nullable\": false,\n      \"description\": \"Name of the record\"\n    },\n    \"description\": {\n      \"type\": \"text\",\n      \"nullable\": true,\n      \"description\": \"Optional description\"\n    },\n    \"status\": {\n      \"type\": \"text\",\n      \"nullable\": false,\n      \"default\": \"'active'\",\n      \"description\": \"Status of the record (e.g., active, inactive)\"\n    },\n    \"metadata\": {\n      \"type\": \"jsonb\",\n      \"nullable\": true,\n      \"description\": \"Additional metadata in JSON format\"\n    },\n    \"createdAt\": {\n      \"type\": \"timestamptz\",\n      \"nullable\": false,\n      \"default\": \"now()\",\n      \"description\": \"Timestamp when the record was created\"\n    },\n    \"updatedAt\": {\n      \"type\": \"timestamptz\",\n      \"nullable\": false,\n      \"default\": \"now()\",\n      \"description\": \"Timestamp when the record was last updated\"\n    },\n    \"deletedAt\": {\n      \"type\": \"timestamptz\",\n      \"nullable\": true,\n      \"description\": \"Timestamp for soft delete; null if not deleted\"\n    }\n  },\n  \"indexes\": [\n    {\n      \"name\": \"idx_all_name\",\n      \"columns\": [\"name\"],\n      \"unique\": false,\n      \"description\": \"Index on name for faster lookups\"\n    },\n    {\n      \"name\": \"idx_all_status\",\n      \"columns\": [\"status\"],\n      \"unique\": false,\n      \"description\": \"Index on status for filtering\"\n    },\n    {\n      \"name\": \"idx_all_created_at\",\n      \"columns\": [\"createdAt\"],\n      \"unique\": false,\n      \"description\": \"Index on createdAt for sorting\"\n    },\n    {\n      \"name\": \"idx_all_deleted_at\",\n      \"columns\": [\"deletedAt\"],\n      \"unique\": false,\n      \"description\": \"Index on deletedAt for soft delete queries\"\n    }\n  ],\n  \"relations\": [\n    // Example relation: each 'all' record belongs to a user (from Supabase Auth)\n    {\n      \"type\": \"belongsTo\",\n      \"table\": \"auth.users\",\n      \"foreignKey\": \"userId\",\n      \"description\": \"The user who owns this record\"\n    }\n  ]\n}"
    },
    {
      "path": "src/modules/all/schema/schema.types.jsonc",
      "content": "// src/modules/all/schema/schema.types.jsonc\n// TypeScript type definitions for the 'all' module schema.\n// These types are used throughout the application for type safety.\n\n{\n  \"All\": {\n    \"id\": \"string\",\n    \"name\": \"string\",\n    \"description\": \"string | null\",\n    \"status\": \"string\",\n    \"metadata\": \"Record<string, any> | null\",\n    \"createdAt\": \"string\",\n    \"updatedAt\": \"string\",\n    \"deletedAt\": \"string | null\",\n    \"userId\": \"string\"\n  },\n  \"AllCreateInput\": {\n    \"name\": \"string\",\n    \"description\": \"string | null\",\n    \"status\": \"string\",\n    \"metadata\": \"Record<string, any> | null\",\n    \"userId\": \"string\"\n  },\n  \"AllUpdateInput\": {\n    \"name\": \"string | undefined\",\n    \"description\": \"string | null | undefined\",\n    \"status\": \"string | undefined\",\n    \"metadata\": \"Record<string, any> | null | undefined\"\n  }\n}"
    },
    {
      "path": "src/modules/all/schema/schema.service.jsonc",
      "content": "// src/modules/all/schema/schema.service.jsonc\n// Service layer for interacting with the 'all' table in Supabase.\n// Provides CRUD operations with soft delete support.\n\nimport { supabase } from '../../../lib/supabaseClient';\nimport type { All, AllCreateInput, AllUpdateInput } from './schema.types';\n\nconst TABLE_NAME = 'all';\n\nexport const schemaService = {\n  /**\n   * Fetch all non-deleted records.\n   */\n  async getAll(): Promise<All[]> {\n    const { data, error } = await supabase\n      .from(TABLE_NAME)\n      .select('*')\n      .is('deletedAt', null)\n      .order('createdAt', { ascending: false });\n\n    if (error) {\n      console.error('Error fetching all records:', error);\n      throw new Error(error.message);\n    }\n\n    return data as All[];\n  },\n\n  /**\n   * Fetch a single record by ID.\n   */\n  async getById(id: string): Promise<All | null> {\n    const { data, error } = await supabase\n      .from(TABLE_NAME)\n      .select('*')\n      .eq('id', id)\n      .is('deletedAt', null)\n      .single();\n\n    if (error) {\n      if (error.code === 'PGRST116') {\n        // No rows returned\n        return null;\n      }\n      console.error('Error fetching record by ID:', error);\n      throw new Error(error.message);\n    }\n\n    return data as All;\n  },\n\n  /**\n   * Create a new record.\n   */\n  async create(input: AllCreateInput): Promise<All> {\n    const { data, error } = await supabase\n      .from(TABLE_NAME)\n      .insert({\n        ...input,\n        createdAt: new Date().toISOString(),\n        updatedAt: new Date().toISOString(),\n      })\n      .select()\n      .single();\n\n    if (error) {\n      console.error('Error creating record:', error);\n      throw new Error(error.message);\n    }\n\n    return data as All;\n  },\n\n  /**\n   * Update an existing record.\n   */\n  async update(id: string, input: AllUpdateInput): Promise<All> {\n    const { data, error } = await supabase\n      .from(TABLE_NAME)\n      .update({\n        ...input,\n        updatedAt: new Date().toISOString(),\n      })\n      .eq('id', id)\n      .is('deletedAt', null)\n      .select()\n      .single();\n\n    if (error) {\n      console.error('Error updating record:', error);\n      throw new Error(error.message);\n    }\n\n    return data as All;\n  },\n\n  /**\n   * Soft delete a record by setting deletedAt timestamp.\n   */\n  async softDelete(id: string): Promise<void> {\n    const { error } = await supabase\n      .from(TABLE_NAME)\n      .update({ deletedAt: new Date().toISOString() })\n      .eq('id', id)\n      .is('deletedAt', null);\n\n    if (error) {\n      console.error('Error soft deleting record:', error);\n      throw new Error(error.message);\n    }\n  },\n\n  /**\n   * Restore a soft-deleted record by clearing deletedAt.\n   */\n  async restore(id: string): Promise<void> {\n    const { error } = await supabase\n      .from(TABLE_NAME)\n      .update({ deletedAt: null })\n      .eq('id', id)\n      .not('deletedAt', 'is', null);\n\n    if (error) {\n      console.error('Error restoring record:', error);\n      throw new Error(error.message);\n    }\n  },\n};"
    },
    {
      "path": "src/modules/all/schema/schema.migration.jsonc",
      "content": "// src/modules/all/schema/schema.migration.jsonc\n// SQL migration script for creating the 'all' table with indexes and foreign keys.\n// This file is intended to be run against the Supabase database.\n\n{\n  \"up\": \"CREATE TABLE IF NOT EXISTS all (\\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\\n  name TEXT NOT NULL,\\n  description TEXT,\\n  status TEXT NOT NULL DEFAULT 'active',\\n  metadata JSONB,\\n  \\\"createdAt\\\" TIMESTAMPTZ NOT NULL DEFAULT now(),\\n  \\\"updatedAt\\\" TIMESTAMPTZ NOT NULL DEFAULT now(),\\n  \\\"deletedAt\\\" TIMESTAMPTZ,\\n  \\\"userId\\\" UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_all_name ON all (name);\\nCREATE INDEX IF NOT EXISTS idx_all_status ON all (status);\\nCREATE INDEX IF NOT EXISTS idx_all_created_at ON all (\\\"createdAt\\\");\\nCREATE INDEX IF NOT EXISTS idx_all_deleted_at ON all (\\\"deletedAt\\\");\\nCREATE INDEX IF NOT EXISTS idx_all_user_id ON all (\\\"userId\\\");\",\n  \"down\": \"DROP TABLE IF EXISTS all;\"\n}"
    },
    {
      "path": "src/modules/all/schema/schema.test.jsonc",
      "content": "// src/modules/all/schema/schema.test.jsonc\n// Unit tests for the schema service.\n// These tests use Jest and mock the Supabase client.\n\nimport { schemaService } from './schema.service';\nimport { supabase } from '../../../lib/supabaseClient';\n\njest.mock('../../../lib/supabaseClient', () => ({\n  supabase: {\n    from: jest.fn().mockReturnThis(),\n    select: jest.fn().mockReturnThis(),\n    insert: jest.fn().mockReturnThis(),\n    update: jest.fn().mockReturnThis(),\n    eq: jest.fn().mockReturnThis(),\n    is: jest.fn().mockReturnThis(),\n    not: jest.fn().mockReturnThis(),\n    order: jest.fn().mockReturnThis(),\n    single: jest.fn(),\n  },\n}));\n\ndescribe('schemaService', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  describe('getAll', () => {\n    it('should return all non-deleted records', async () => {\n      const mockData = [{ id: '1', name: 'Test' }];\n      (supabase.from().select().is().order as jest.Mock).mockResolvedValue({ data: mockData, error: null });\n\n      const result = await schemaService.getAll();\n      expect(result).toEqual(mockData);\n      expect(supabase.from).toHaveBeenCalledWith('all');\n      expect(supabase.from().select).toHaveBeenCalledWith('*');\n      expect(supabase.from().select().is).toHaveBeenCalledWith('deletedAt', null);\n      expect(supabase.from().select().is().order).toHaveBeenCalledWith('createdAt', { ascending: false });\n    });\n\n    it('should throw an error if Supabase returns an error', async () => {\n      const mockError = { message: 'Database error' };\n      (supabase.from().select().is().order as jest.Mock).mockResolvedValue({ data: null, error: mockError });\n\n      await expect(schemaService.getAll()).rejects.toThrow('Database error');\n    });\n  });\n\n  describe('getById', () => {\n    it('should return a record by ID', async () => {\n      const mockData = { id: '1', name: 'Test' };\n      (supabase.from().select().eq().is().single as jest.Mock).mockResolvedValue({ data: mockData, error: null });\n\n      const result = await schemaService.getById('1');\n      expect(result).toEqual(mockData);\n      expect(supabase.from).toHaveBeenCalledWith('all');\n      expect(supabase.from().select).toHaveBeenCalledWith('*');\n      expect(supabase.from().select().eq).toHaveBeenCalledWith('id', '1');\n      expect(supabase.from().select().eq().is).toHaveBeenCalledWith('deletedAt', null);\n      expect(supabase.from().select().eq().is().single).toHaveBeenCalled();\n    });\n\n    it('should return null if no record found', async () => {\n      (supabase.from().select().eq().is().single as jest.Mock).mockResolvedValue({ data: null, error: { code: 'PGRST116' } });\n\n      const result = await schemaService.getById('1');\n      expect(result).toBeNull();\n    });\n\n    it('should throw an error for other errors', async () => {\n      const mockError = { message: 'Database error' };\n      (supabase.from().select().eq().is().single as jest.Mock).mockResolvedValue({ data: null, error: mockError });\n\n      await expect(schemaService.getById('1')).rejects.toThrow('Database error');\n    });\n  });\n\n  describe('create', () => {\n    it('should create a new record', async () => {\n      const input = { name: 'Test', userId: 'user1' };\n      const mockData = { id: '1', ...input, createdAt: expect.any(String), updatedAt: expect.any(String) };\n      (supabase.from().insert().select().single as jest.Mock).mockResolvedValue({ data: mockData, error: null });\n\n      const result = await schemaService.create(input);\n      expect(result).toEqual(mockData);\n      expect(supabase.from).toHaveBeenCalledWith('all');\n      expect(supabase.from().insert).toHaveBeenCalledWith(expect.objectContaining(input));\n      expect(supabase.from().insert().select).toHaveBeenCalled();\n      expect(supabase.from().insert().select().single).toHaveBeenCalled();\n    });\n\n    it('should throw an error if creation fails', async () => {\n      const mockError = { message: 'Creation error' };\n      (supabase.from().insert().select().single as jest.Mock).mockResolvedValue({ data: null, error: mockError });\n\n      await expect(schemaService.create({ name: 'Test', userId: 'user1' })).rejects.toThrow('Creation error');\n    });\n  });\n\n  describe('update', () => {\n    it('should update an existing record', async () => {\n      const input = { name: 'Updated' };\n      const mockData = { id: '1', name: 'Updated', updatedAt: expect.any(String) };\n      (supabase.from().update().eq().is().select().single as jest.Mock).mockResolvedValue({ data: mockData, error: null });\n\n      const result = await schemaService.update('1', input);\n      expect(result).toEqual(mockData);\n      expect(supabase.from).toHaveBeenCalledWith('all');\n      expect(supabase.from().update).toHaveBeenCalledWith(expect.objectContaining(input));\n      expect(supabase.from().update().eq).toHaveBeenCalledWith('id', '1');\n      expect(supabase.from().update().eq().is).toHaveBeenCalledWith('deletedAt', null);\n      expect(supabase.from().update().eq().is().select).toHaveBeenCalled();\n      expect(supabase.from().update().eq().is().select().single).toHaveBeenCalled();\n    });\n\n    it('should throw an error if update fails', async () => {\n