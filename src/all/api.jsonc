{"files":[{"path":"src/modules/all/all.controller.jsonc","content":"// All module controller — CRUD handlers with pagination, validation, and error handling.\n// Uses Supabase Auth for identity and the project database for persistence.\n{\n  \"name\": \"all.controller\",\n  \"module\": \"all\",\n  \"imports\": {\n    \"supabase\": \"@supabase/supabase-js\",\n    \"validation\": \"./all.validation.jsonc\"\n  },\n  \"constants\": {\n    \"TABLE\": \"all\",\n    \"DEFAULT_PAGE\": 1,\n    \"DEFAULT_LIMIT\": 20,\n    \"MAX_LIMIT\": 100\n  },\n  \"helpers\": {\n    \"ok\": {\n      \"description\": \"Format a successful response envelope.\",\n      \"params\": [\"data\", \"meta\"],\n      \"returns\": {\n        \"success\": true,\n        \"data\": \"{{data}}\",\n        \"meta\": \"{{meta}}\"\n      }\n    },\n    \"fail\": {\n      \"description\": \"Format an error response envelope.\",\n      \"params\": [\"status\", \"code\", \"message\", \"details\"],\n      \"returns\": {\n        \"success\": false,\n        \"error\": {\n          \"code\": \"{{code}}\",\n          \"message\": \"{{message}}\",\n          \"details\": \"{{details}}\"\n        },\n        \"status\": \"{{status}}\"\n      }\n    },\n    \"parsePagination\": {\n      \"description\": \"Normalize and clamp pagination query params.\",\n      \"params\": [\"query\"],\n      \"logic\": [\n        \"const page = Math.max(parseInt(query.page, 10) || DEFAULT_PAGE, 1)\",\n        \"const limit = Math.min(Math.max(parseInt(query.limit, 10) || DEFAULT_LIMIT, 1), MAX_LIMIT)\",\n        \"const from = (page - 1) * limit\",\n        \"const to = from + limit - 1\",\n        \"return { page, limit, from, to }\"\n      ]\n    },\n    \"requireAuth\": {\n      \"description\": \"Resolve the authenticated Supabase user or throw a 401.\",\n      \"params\": [\"context\"],\n      \"logic\": [\n        \"const { data: { user }, error } = await context.supabase.auth.getUser()\",\n        \"if (error || !user) throw fail(401, 'UNAUTHORIZED', 'Authentication required')\",\n        \"return user\"\n      ]\n    }\n  },\n  \"handlers\": {\n    \"list\": {\n      \"method\": \"GET\",\n      \"path\": \"/\",\n      \"description\": \"List all records with pagination.\",\n      \"logic\": [\n        \"const user = await requireAuth(context)\",\n        \"const { page, limit, from, to } = parsePagination(context.query)\",\n        \"const { data, error, count } = await context.supabase\",\n        \"  .from(TABLE)\",\n        \"  .select('*', { count: 'exact' })\",\n        \"  .eq('user_id', user.id)\",\n        \"  .order('created_at', { ascending: false })\",\n        \"  .range(from, to)\",\n        \"if (error) throw fail(500, 'DB_ERROR', error.message)\",\n        \"return ok(data ?? [], { page, limit, total: count ?? 0, pages: Math.ceil((count ?? 0) / limit) })\"\n      ]\n    },\n    \"get\": {\n      \"method\": \"GET\",\n      \"path\": \"/:id\",\n      \"description\": \"Fetch a single record by id.\",\n      \"logic\": [\n        \"const user = await requireAuth(context)\",\n        \"const { id } = context.params\",\n        \"if (!id) throw fail(400, 'VALIDATION_ERROR', 'id is required')\",\n        \"const { data, error } = await context.supabase\",\n        \"  .from(TABLE)\",\n        \"  .select('*')\",\n        \"  .eq('id', id)\",\n        \"  .eq('user_id', user.id)\",\n        \"  .single()\",\n        \"if (error) throw fail(404, 'NOT_FOUND', 'Record not found')\",\n        \"return ok(data)\"\n      ]\n    },\n    \"create\": {\n      \"method\": \"POST\",\n      \"path\": \"/\",\n      \"description\": \"Create a new record.\",\n      \"logic\": [\n        \"const user = await requireAuth(context)\",\n        \"const payload = validateCreate(context.body)\",\n        \"const { data, error } = await context.supabase\",\n        \"  .from(TABLE)\",\n        \"  .insert({ ...payload, user_id: user.id })\",\n        \"  .select('*')\",\n        \"  .single()\",\n        \"if (error) throw fail(500, 'DB_ERROR', error.message)\",\n        \"return ok(data, { status: 201 })\"\n      ]\n    },\n    \"update\": {\n      \"method\": \"PUT\",\n      \"path\": \"/:id\",\n      \"description\": \"Update an existing record.\",\n      \"logic\": [\n        \"const user = await requireAuth(context)\",\n        \"const { id } = context.params\",\n        \"if (!id) throw fail(400, 'VALIDATION_ERROR', 'id is required')\",\n        \"const payload = validateUpdate(context.body)\",\n        \"const { data, error } = await context.supabase\",\n        \"  .from(TABLE)\",\n        \"  .update(payload)\",\n        \"  .eq('id', id)\",\n        \"  .eq('user_id', user.id)\",\n        \"  .select('*')\",\n        \"  .single()\",\n        \"if (error) throw fail(404, 'NOT_FOUND', 'Record not found')\",\n        \"return ok(data)\"\n      ]\n    },\n    \"remove\": {\n      \"method\": \"DELETE\",\n      \"path\": \"/:id\",\n      \"description\": \"Delete a record by id.\",\n      \"logic\": [\n        \"const user = await requireAuth(context)\",\n        \"const { id } = context.params\",\n        \"if (!id) throw fail(400, 'VALIDATION_ERROR', 'id is required')\",\n        \"const { error } = await context.supabase\",\n        \"  .from(TABLE)\",\n        \"  .delete()\",\n        \"  .eq('id', id)\",\n        \"  .eq('user_id', user.id)\",\n        \"if (error) throw fail(404, 'NOT_FOUND', 'Record not found')\",\n        \"return ok({ id })\"\n      ]\n    }\n  },\n  \"errorHandling\": {\n    \"statusCodes\": {\n      \"400\": \"VALIDATION_ERROR\",\n      \"401\": \"UNAUTHORIZED\",\n      \"403\": \"FORBIDDEN\",\n      \"404\": \"NOT_FOUND\",\n      \"409\": \"CONFLICT\",\n      \"500\": \"INTERNAL_ERROR\"\n    },\n    \"onError\": [\n      \"const status = err.status || 500\",\n      \"const code = err.error?.code || 'INTERNAL_ERROR'\",\n      \"const message = err.error?.message || 'Unexpected server error'\",\n      \"return fail(status, code, message, err.error?.details)\"\n    ]\n  }\n}\n"},{"path":"src/modules/all/all.routes.jsonc","content":"// All module routes — maps HTTP verbs to controller handlers.\n{\n  \"name\": \"all.routes\",\n  \"module\": \"all\",\n  \"basePath\": \"/api/all\",\n  \"imports\": {\n    \"controller\": \"./all.controller.jsonc\",\n    \"validation\": \"./all.validation.jsonc\"\n  },\n  \"middleware\": [\n    \"authMiddleware\",\n    \"jsonBodyParser\",\n    \"requestLogger\"\n  ],\n  \"routes\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/\",\n      \"handler\": \"controller.handlers.list\",\n      \"middleware\": [\"validateQuery\"],\n      \"description\": \"List records with pagination.\"\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/:id\",\n      \"handler\": \"controller.handlers.get\",\n      \"middleware\": [\"validateParams\"],\n      \"description\": \"Get a single record.\"\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/\",\n      \"handler\": \"controller.handlers.create\",\n      \"middleware\": [\"validateBody\"],\n      \"description\": \"Create a record.\"\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/:id\",\n      \"handler\": \"controller.handlers.update\",\n      \"middleware\": [\"validateParams\", \"validateBody\"],\n      \"description\": \"Update a record.\"\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/:id\",\n      \"handler\": \"controller.handlers.remove\",\n      \"middleware\": [\"validateParams\"],\n      \"description\": \"Delete a record.\"\n    }\n  ],\n  \"errorHandler\": \"controller.errorHandling.onError\"\n}\n"},{"path":"src/modules/all/all.validation.jsonc","content":"// All module validation — request schema validation middleware.\n{\n  \"name\": \"all.validation\",\n  \"module\": \"all\",\n  \"schemas\": {\n    \"create\": {\n      \"type\": \"object\",\n      \"required\": [\"name\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 255 },\n        \"description\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"status\": { \"type\": \"string\", \"enum\": [\"active\", \"inactive\", \"archived\"] },\n        \"metadata\": { \"type\": \"object\" }\n      }\n    },\n    \"update\": {\n      \"type\": \"object\",\n      \"minProperties\": 1,\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 255 },\n        \"description\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"status\": { \"type\": \"string\", \"enum\": [\"active\", \"inactive\", \"archived\"] },\n        \"metadata\": { \"type\": \"object\" }\n      }\n    },\n    \"params\": {\n      \"type\": \"object\",\n      \"required\": [\"id\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"format\": \"uuid\" }\n      }\n    },\n    \"query\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n        \"limit\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 },\n        \"sort\": { \"type\": \"string\", \"enum\": [\"created_at\", \"updated_at\", \"name\"] },\n        \"order\": { \"type\": \"string\", \"enum\": [\"asc\", \"desc\"], \"default\": \"desc\" }\n      }\n    }\n  },\n  \"middleware\": {\n    \"validateBody\": {\n      \"description\": \"Validate request body against create/update schema.\",\n      \"logic\": [\n        \"const schema = context.method === 'POST' ? schemas.create : schemas.update\",\n        \"const { error, value } = validate(context.body, schema)\",\n        \"if (error) throw fail(400, 'VALIDATION_ERROR', 'Invalid request body', error.details)\",\n        \"context.body = value\",\n        \"return next()\"\n      ]\n    },\n    \"validateParams\": {\n      \"description\": \"Validate route params (id must be a uuid).\",\n      \"logic\": [\n        \"const { error } = validate(context.params, schemas.params)\",\n        \"if (error) throw fail(400, 'VALIDATION_ERROR', 'Invalid route params', error.details)\",\n        \"return next()\"\n      ]\n    },\n    \"validateQuery\": {\n      \"description\": \"Validate and coerce pagination query params.\",\n      \"logic\": [\n        \"const { error, value } = validate(context.query, schemas.query)\",\n        \"if (error) throw fail(400, 'VALIDATION_ERROR', 'Invalid query params', error.details)\",\n        \"context.query = value\",\n        \"return next()\"\n      ]\n    }\n  },\n  \"validate\": {\n    \"description\": \"Minimal schema validator returning { error, value }.\",\n    \"logic\": [\n      \"const errors = []\",\n      \"const value = {}\",\n      \"for (const key of Object.keys(schema.properties || {})) {\",\n      \"  const rule = schema.properties[key]\",\n      \"  const raw = input?.[key]\",\n      \"  if (raw === undefined || raw === null) {\",\n      \"    if (schema.required?.includes(key)) errors.push({ field: key, message: 'is required' })\",\n      \"    else if (rule.default !== undefined) value[key] = rule.default\",\n      \"    continue\",\n      \"  }\",\n      \"  if (rule.type === 'integer') {\",\n      \"    const n = parseInt(raw, 10)\",\n      \"    if (Number.isNaN(n)) { errors.push({ field: key, message: 'must be an integer' }); continue }\",\n      \"    if (rule.minimum !== undefined && n < rule.minimum) errors.push({ field: key, message: `must be >= ${rule.minimum}` })\",\n      \"    if (rule.maximum !== undefined && n > rule.maximum) errors.push({ field: key, message: `must be <= ${rule.maximum}` })\",\n      \"    value[key] = n\",\n      \"    continue\",\n      \"  }\",\n      \"  if (rule.type === 'string') {\",\n      \"    if (typeof raw !== 'string') { errors.push({ field: key, message: 'must be a string' }); continue }\",\n      \"    if (rule.minLength !== undefined && raw.length < rule.minLength) errors.push({ field: key, message: `must be at least ${rule.minLength} chars` })\",\n      \"    if (rule.maxLength !== undefined && raw.length > rule.maxLength) errors.push({ field: key, message: `must be at most ${rule.maxLength} chars` })\",\n      \"    if (rule.enum && !rule.enum.includes(raw)) errors.push({ field: key, message: `must be one of ${rule.enum.join(', ')}` })\",\n      \"    value[key] = raw\",\n      \"    continue\",\n      \"  }\",\n      \"  if (rule.type === 'object') {\",\n      \"    if (typeof raw !== 'object' || Array.isArray(raw)) { errors.push({ field: key, message: 'must be an object' }); continue }\",\n      \"    value[key] = raw\",\n      \"    continue\",\n      \"  }\",\n      \"  value[key] = raw\",\n      \"}\",\n      \"if (schema.minProperties && Object.keys(value).length < schema.minProperties) errors.push({ field: '_root', message: `must provide at least ${schema.minProperties} field(s)` })\",\n      \"return errors.length ? { error: { details: errors } } : { value }\"\n    ]\n  }\n}\n"},{"path":"src/modules/all/index.jsonc","content":"// All module barrel — public surface for the 'all' API module.\n{\n