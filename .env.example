# Copy to .env and fill in the values you need.
# Every variable here is optional, but payments and Google sign-in are unusable
# without theirs. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# The Paystack secret key is NOT set here. It lives in the server environment
# (see functions/), because anything in a VITE_ variable is inlined into the
# public bundle. Setting a secret here would publish it.
# Set PAYSTACK_SECRET_KEY as a Firebase Functions secret:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
#
# Only needed if the API lives somewhere other than the same origin that
# Firebase Hosting serves the app from. Normally leave this unset: firebase.json
# proxies /api/* to the functions.
# VITE_API_BASE=

# Public support details, shown by the Aqua panel. Left blank, the panel says it
# has no contact details rather than inventing a phone number.
# VITE_SUPPORT_PHONE=
# VITE_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Firebase (optional - enables real-time sync, push notifications)
# ---------------------------------------------------------------------------
# These are all public config values from the Firebase console.
# Without them the app runs in offline/demo mode using localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Set to "true" to connect to local Firebase emulators in development
VITE_USE_EMULATORS=false

# ---------------------------------------------------------------------------
# Supabase (the migration target for the backend)
# ---------------------------------------------------------------------------
# When the project ref and anon key are both set, the app talks to Supabase Edge
# Functions. When they are absent it falls back to the same-origin `/api` paths
# that firebase.json routes at the Firebase Functions, so nothing breaks for a
# developer who has not set these.
#
# Project reference from your Supabase dashboard (URL format). It must be the
# ref of a project that actually exists: an invented one silently sends every
# request to a host that does not resolve.
# VITE_SUPABASE_PROJECT_REF=
# Supabase anon (public) key. Public by design and safe in the bundle; it grants
# no privileged access. The service role key is the server's secret and must
# never appear here.
# VITE_SUPABASE_ANON_KEY=
# Set this only to override the derived URL, e.g. for a local stack.
# VITE_SUPABASE_URL=

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# Client id of a WEB APPLICATION OAuth client. Without it the app renders no
# Google button; see README "Google sign-in".
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Meta (Facebook) sign-in
# ---------------------------------------------------------------------------
# App id of a Facebook / Meta app with Facebook Login enabled. Without it the
# app renders no Meta button.
VITE_FACEBOOK_CLIENT_ID=
