# Copy to .env and fill in the values you need.
# Every variable here is optional, but payments and Google sign-in are unusable
# without theirs. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# The Paystack secret key is NOT set here. It lives in the server environment
# (see functions/), because anything in a VITE_ variable is inlined into the
# public bundle. Setting a secret here would publish it.
# Set PAYSTACK_SECRET_KEY as a Firebase Functions secret:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
#
# Only needed if the API lives somewhere other than the same origin that
# Firebase Hosting serves the app from. Normally leave this unset: firebase.json
# proxies /api/* to the functions.
# VITE_API_BASE=

# Public support details, shown by the Aqua panel. Left blank, the panel says it
# has no contact details rather than inventing a phone number.
# VITE_SUPPORT_PHONE=
# VITE_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# Client id of a WEB APPLICATION OAuth client. Without it the app renders no
# Google button; see README "Google sign-in".
VITE_GOOGLE_CLIENT_ID=
