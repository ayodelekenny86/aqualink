# Frontend environment for AquaLink.
# Copy to .env and fill in values from your Supabase project dashboard.
# Never commit the real .env file.

# Supabase project. Either the full URL or the project ref is required, plus
# the anon key. The anon key is public by design: it identifies the caller and
# grants no privileged access. The service role key stays on the server only.
VITE_SUPABASE_PROJECT_REF=your-project-ref
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: point the dev server at a local Supabase stack. Without it, the
# dev server proxies /api to the Firebase emulator at 127.0.0.1:5000.
# AQUALINK_SUPABASE_TARGET=http://127.0.0.1:54321
# AQUALINK_API_TARGET=http://127.0.0.1:5000

# Optional: Google sign-in client id, for the RS256-verified login button.
VITE_GOOGLE_CLIENT_ID=

# Optional: Facebook app id, for the Graph-API-verified login button.
# Drivers who sign in with Google or Facebook link a phone number on first sign-in
# so they can be matched to their fleet roster entry.
VITE_FACEBOOK_CLIENT_ID=

# Server-side: set in your Supabase project's Edge Function environment variables.
# The Gemini API key never reaches the browser. The AI Edge Function
# (supabase/functions/ai) uses it to answer assistant questions.
# GEMINI_API_KEY=your-gemini-api-key