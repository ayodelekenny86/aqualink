# Copy to functions/.env and fill in. The CLI deploys this file with the code.
#
# Only the server reads this. Nothing here is ever sent to a browser, which is
# why the Paystack secret key belongs in this file and not in the root .env:
# every VITE_ variable is inlined into the public bundle at build time.

# ---------------------------------------------------------------------------
# Paystack (required for payments)
# ---------------------------------------------------------------------------
# Secret key from the Paystack dashboard, Settings -> API Keys & Integration.
# Use the TEST key (sk_test_...) while developing and the LIVE key only once you
# are taking real money.
#   PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Payment return URL (required for payments)
# ---------------------------------------------------------------------------
# Where Paystack sends the customer back to after they authorise the charge.
# Without this the checkout leaves the app and never comes back, so the payment
# is never verified and no receipt is ever issued.
#
# Use the hosted domain, not localhost: Paystack cannot redirect to a machine on
# your network. For local work, expose the app with `firebase emulators:start`
# and use the emulator's host, or run a tunnel (e.g. `cloudflared tunnel`) and
# put that URL here.
#   APP_ORIGIN=https://your-project.web.app

# ---------------------------------------------------------------------------
# Operations admin (optional)
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API directly.
# Left empty, the app works because Firebase Hosting proxies /api same-origin.
#   ALLOWED_ORIGINS=https://your-project.web.app

# Email address the first ops account is created for, bootstrapped once via
# /api/bootstrap/ops with OPS_BOOTSTRAP_TOKEN.
#   OPS_ADMIN_EMAIL=ops@yourdomain.com

# OPS_BOOTSTRAP_TOKEN, OPS_ADMIN_PASSWORD and OPS_SESSION_SECRET are declared
# with defineSecret, not defineString, so they do not belong in this file. Set
# them as managed secrets instead:
#   firebase functions:secrets:set OPS_BOOTSTRAP_TOKEN
#   firebase functions:secrets:set OPS_ADMIN_PASSWORD
#   firebase functions:secrets:set OPS_SESSION_SECRET
